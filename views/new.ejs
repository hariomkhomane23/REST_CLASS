<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create New Post</title>
</head>

<body>

    <h1>Create New Post</h1>

    <form action="/posts" method="post">

        <input
            placeholder="Enter username"
            name="username"
        >

        <br><br>

        <textarea
            placeholder="Write your post"
            name="content"
        ></textarea>

        <br><br>

        <button type="submit">
            Submit Post
        </button>

    </form>

</body>

</html>